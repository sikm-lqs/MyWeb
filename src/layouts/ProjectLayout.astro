---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import Button from "../components/ui/Button.astro";
import { ui } from "../i18n/ui";
import { formatDate, type SiteLang } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: SiteLang;
  currentPath: string;
  translationHref?: string;
  publishedAt: string;
  updatedAt?: string;
  status: string;
  stack: string[];
  cover?: string;
  coverAlt?: string;
  repoUrl?: string;
  demoUrl?: string;
  caseStudyUrl?: string;
  backHref: string;
  wordCount?: number | string;
}

const {
  title,
  description,
  lang,
  currentPath,
  translationHref,
  publishedAt,
  updatedAt,
  status,
  stack,
  cover,
  coverAlt = "",
  repoUrl,
  demoUrl,
  caseStudyUrl,
  backHref,
  wordCount,
} = Astro.props;

const copy = ui[lang];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  currentPath={currentPath}
  translationHref={translationHref}
>
  <section class="pb-20 pt-14">
    <Container>
      <div>
        <div class="mt-8 grid gap-8">
          <div>
            <!-- 项目页也支持面包屑 + meta + 字数 -->
            <div class="flat-item-meta">
              <a href={lang === 'zh-CN' ? '/' : '/en'}>{lang === 'zh-CN' ? '首页' : 'Home'}</a>
              <span aria-hidden="true">›</span>
              <a href={backHref}>{lang === 'zh-CN' ? '项目' : 'Projects'}</a>
            </div>
            <div class="flat-item-meta mt-3">
              <span>{status}</span>
              <span aria-hidden="true">·</span>
              <span>{formatDate(publishedAt, lang)}</span>
              {wordCount && <span>· {wordCount} {lang === 'zh-CN' ? '字' : 'words'}</span>}
            </div>
            <h1 class="mt-5 text-3xl font-semibold leading-[1.25] tracking-tight text-[var(--text-main)] sm:text-4xl">
              {title}
            </h1>
            <p class="mt-5 text-lg leading-8 text-[var(--text-muted)]">{description}</p>
            {stack.length > 0 && (
              <p class="flat-item-tags mt-6">{stack.join(" · ")}</p>
            )}
            <div class="mt-8 flex flex-wrap gap-3">
              {repoUrl && (
                <Button href={repoUrl} target="_blank" rel="noreferrer">
                  {copy.labels.github}
                </Button>
              )}
              {demoUrl && (
                <Button href={demoUrl} target="_blank" rel="noreferrer" variant="secondary">
                  {copy.labels.demo}
                </Button>
              )}
              {caseStudyUrl && (
                <Button href={caseStudyUrl} target="_blank" rel="noreferrer" variant="secondary">
                  {copy.labels.caseStudy}
                </Button>
              )}
            </div>
          </div>

          {cover && (
            <img
              src={cover}
              alt={coverAlt}
              class="rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface)]"
            />
          )}
        </div>
        <article class="rich-content mt-12">
          <slot />
        </article>
      </div>
    </Container>
  </section>
</BaseLayout>

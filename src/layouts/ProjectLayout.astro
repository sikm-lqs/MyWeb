---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { ui } from "../i18n/ui";
import { formatDate, type SiteLang } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: SiteLang;
  currentPath: string;
  translationHref?: string;
  publishedAt: string;
  updatedAt?: string;
  status: string;
  stack: string[];
  cover?: string;
  coverAlt?: string;
  repoUrl?: string;
  demoUrl?: string;
  caseStudyUrl?: string;
  backHref: string;
  wordCount?: number | string;
}

const {
  title,
  description,
  lang,
  currentPath,
  translationHref,
  publishedAt,
  updatedAt,
  status,
  stack,
  cover,
  coverAlt = "",
  repoUrl,
  demoUrl,
  caseStudyUrl,
  backHref,
  wordCount,
} = Astro.props;

const copy = ui[lang];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  currentPath={currentPath}
  translationHref={translationHref}
>
  <section class="pb-20 pt-14">
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mt-8 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
          <div>
            <!-- 项目页也支持面包屑 + emoji meta + 字数 -->
            <div class="text-sm text-[var(--text-subtle)] mb-1">
              <a href={lang === 'zh-CN' ? '/' : '/en'} class="hover:text-[var(--text-main)] transition-colors">{lang === 'zh-CN' ? '首页' : 'Home'}</a>
              <span class="mx-1">›</span>
              <a href={backHref} class="hover:text-[var(--text-main)] transition-colors">{lang === 'zh-CN' ? '项目' : 'Projects'}</a>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--text-subtle)]">
              <span class="inline-flex items-center gap-1">📅 {formatDate(publishedAt, lang)}</span>
              {wordCount && <span class="inline-flex items-center gap-1">📝 {wordCount} {lang === 'zh-CN' ? '字' : 'words'}</span>}
            </div>
            <h1 class="mt-5 text-3xl font-semibold tracking-tight text-[var(--text-main)] sm:text-4xl">
              {title}
            </h1>
            <p class="mt-5 text-lg leading-8 text-[var(--text-muted)]">{description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              <Badge tone="accent">{status}</Badge>
              {stack.map((item) => <Badge>{item}</Badge>)}
            </div>
            <div class="mt-8 flex flex-wrap gap-3">
              {repoUrl && (
                <Button href={repoUrl} target="_blank" rel="noreferrer">
                  {copy.labels.github}
                </Button>
              )}
              {demoUrl && (
                <Button href={demoUrl} target="_blank" rel="noreferrer" variant="secondary">
                  {copy.labels.demo}
                </Button>
              )}
              {caseStudyUrl && (
                <Button href={caseStudyUrl} target="_blank" rel="noreferrer" variant="secondary">
                  {copy.labels.caseStudy}
                </Button>
              )}
            </div>
          </div>

          {cover && (
            <img
              src={cover}
              alt={coverAlt}
              class="rounded-[1.8rem] border border-[var(--border-paper)] bg-white shadow-[var(--shadow-soft)]"
            />
          )}
        </div>
        <article class="rich-content mx-auto mt-12 max-w-4xl">
          <slot />
        </article>
      </div>
    </Container>
  </section>
</BaseLayout>

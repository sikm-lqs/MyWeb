---
interface Props {
  href?: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href ?? "#"}
  class="rounded-full border border-[var(--border-paper)] px-3 py-2 text-[var(--text-muted)] transition hover:border-[color-mix(in_srgb,var(--accent)_35%,var(--border))] hover:text-[var(--text-main)]"
>
  {label}
</a>

---
interface Props {
  href?: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href ?? "#"}
  class="rounded-full border border-[var(--border-strong)] px-3 py-2 text-[var(--text-muted)] transition hover:bg-[var(--surface-soft)] hover:text-[var(--text-main)]"
>
  {label}
</a>

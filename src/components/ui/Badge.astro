---
interface Props {
  tone?: "default" | "accent";
  compact?: boolean;
}

const { tone = "default", compact = false } = Astro.props;
const className =
  tone === "accent"
    ? `badge badge-accent ${compact ? "px-2.5 py-0.5 text-[0.69rem]" : "px-3 py-1 text-xs"}`
    : `badge ${compact ? "px-2.5 py-0.5 text-[0.69rem]" : "px-3 py-1 text-xs"}`;
---

<span class={className}>
  <slot />
</span>

---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  target?: string;
  rel?: string;
}

const {
  href,
  variant = "primary",
  target,
  rel,
} = Astro.props;

const className =
  variant === "primary"
    ? "inline-flex items-center justify-center rounded-full bg-[var(--accent)] px-5 py-2 text-sm font-medium text-[var(--text-on-primary)] transition hover:bg-[var(--btn-primary-hover)]"
    : "inline-flex items-center justify-center rounded-full border border-[var(--border-strong)] bg-transparent px-5 py-2 text-sm font-medium text-[var(--text-main)] transition hover:bg-[var(--surface-soft)]";
const style = undefined;
---

<a class={className} style={style} href={href} target={target} rel={rel}>
  <slot />
</a>

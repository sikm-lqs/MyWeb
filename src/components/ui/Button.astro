---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  target?: string;
  rel?: string;
}

const {
  href,
  variant = "primary",
  target,
  rel,
} = Astro.props;

const className =
  variant === "primary"
    ? "inline-flex items-center justify-center rounded-full bg-[#111] px-5 py-2 text-sm font-medium text-[#f4efe6] transition hover:bg-black"
    : "inline-flex items-center justify-center rounded-full border border-[#d4c9b8] bg-transparent px-5 py-2 text-sm font-medium text-[#1f1a14] transition hover:bg-[#f0e9df]";
const style = undefined;
---

<a class={className} style={style} href={href} target={target} rel={rel}>
  <slot />
</a>

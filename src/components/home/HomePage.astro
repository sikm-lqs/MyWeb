---
import Container from "../layout/Container.astro";
import SocialLink from "../ui/SocialLink.astro";
import ArticleCard from "../content/ArticleCard.astro";
import ProjectCard from "../content/ProjectCard.astro";
import { ui } from "../../i18n/ui";
import {
  BILIBILI_HANDLE,
  BILIBILI_URL,
  GITHUB_HANDLE,
  GITHUB_URL,
  X_HANDLE,
  X_URL,
  WECHAT_HANDLE,
  WECHAT_URL,
  XIAOHONGSHU_HANDLE,
  XIAOHONGSHU_URL,
  getCollectionPath,
  type SiteLang,
} from "../../i18n/utils";
import {
  getEntryPath,
  getLatestEntries,
} from "../../lib/content/translations";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const copy = ui[lang];
const [latestProjects, latestBlog, latestLife] = await Promise.all([
  getLatestEntries("projects", lang, 3),
  getLatestEntries("writing", lang, 4),
  getLatestEntries("life", lang, 2),
]);

const socials = [
  { platform: "github", href: GITHUB_URL, label: copy.labels.github, handle: GITHUB_HANDLE },
  { platform: "bilibili", href: BILIBILI_URL, label: copy.labels.bilibili, handle: BILIBILI_HANDLE },
  { platform: "x", href: X_URL, label: copy.labels.x, handle: X_HANDLE },
  { platform: "xiaohongshu", href: XIAOHONGSHU_URL, label: copy.labels.xiaohongshu, handle: XIAOHONGSHU_HANDLE },
  { platform: "wechat", href: WECHAT_URL, label: copy.labels.wechat, handle: WECHAT_HANDLE },
] as const;
const availableSocials = socials.filter((item) => item.href.length > 0);
---

<Container>
  <section class="home-hero">
    <h1>Welcome to Sikm's log</h1>
    <p class="home-hero-subtitle">{copy.home.heroSubtitle}</p>
    <div class="home-hero-links">
      {availableSocials.map((item) => (
        <SocialLink
          platform={item.platform}
          href={item.href}
          label={item.label}
          handle={item.handle}
          iconOnly
        />
      ))}
    </div>
  </section>

    <section class="home-section">
      <div class="section-heading-row">
        <p class="section-eyebrow">{copy.home.writingTitle}</p>
        <a href={getCollectionPath("writing", lang)}>{copy.labels.more} →</a>
      </div>
      <div class="flat-list">
        {latestBlog.map((entry, index) => (
          <ArticleCard
            href={getEntryPath("writing", lang, entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            publishedAt={entry.data.publishedAt}
            tags={entry.data.tags}
            readTime={entry.data.readTime}
            lang={lang}
            featured={index === 0}
          />
        ))}
      </div>
    </section>

    <section class="home-section">
      <div class="section-heading-row">
        <p class="section-eyebrow">{copy.home.projectsTitle}</p>
        <a href={getCollectionPath("projects", lang)}>{copy.labels.more} →</a>
      </div>
      <div class="flat-list">
        {latestProjects.map((entry) => (
          <ProjectCard
            href={getEntryPath("projects", lang, entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            status={entry.data.status}
            stack={entry.data.stack}
            publishedAt={entry.data.publishedAt}
            lang={lang}
            repoUrl={entry.data.repoUrl}
            demoUrl={entry.data.demoUrl}
          />
        ))}
      </div>
    </section>

    <section class="home-section">
      <div class="section-heading-row">
        <p class="section-eyebrow">{copy.home.lifeTitle}</p>
        <a href={getCollectionPath("life", lang)}>{copy.labels.more} →</a>
      </div>
      <div class="flat-list">
        {latestLife.map((entry) => (
          <ArticleCard
            href={getEntryPath("life", lang, entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            publishedAt={entry.data.publishedAt}
            tags={entry.data.tags}
            readTime={entry.data.readTime}
            lang={lang}
          />
        ))}
      </div>
    </section>
</Container>

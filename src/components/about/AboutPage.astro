---
import Container from "../layout/Container.astro";
import SocialLink from "../ui/SocialLink.astro";
import { ui } from "../../i18n/ui";
import {
  BILIBILI_HANDLE,
  BILIBILI_URL,
  GITHUB_HANDLE,
  GITHUB_URL,
  X_HANDLE,
  X_URL,
  WECHAT_HANDLE,
  WECHAT_URL,
  XIAOHONGSHU_HANDLE,
  XIAOHONGSHU_URL,
  type SiteLang,
} from "../../i18n/utils";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const copy = ui[lang];
---

<section class="pb-20 pt-14">
  <Container>
    <div class="page-head">
      <p class="section-eyebrow">{copy.about.eyebrow}</p>
      <h1>{copy.about.title}</h1>
      <p>{copy.about.lead}</p>
    </div>

    <div class="mt-12 grid gap-6">
      <div class="space-y-6">
        <section class="rounded-[0.75rem] border border-[var(--border)] bg-[var(--surface)] p-6">
          <h2 class="text-xl font-semibold text-[var(--text-main)]">{copy.about.identityTitle}</h2>
          <p class="mt-3 text-[var(--text-muted)]">{copy.about.identityBody}</p>
        </section>

        <section class="rounded-[0.75rem] border border-[var(--border)] bg-[var(--surface)] p-6">
          <h2 class="text-xl font-semibold text-[var(--text-main)]">{copy.about.focusTitle}</h2>
          <p class="mt-3 text-[var(--text-muted)]">{copy.about.focusBody}</p>
        </section>

        <section class="rounded-[0.75rem] border border-[var(--border)] bg-[var(--surface)] p-6">
          <h2 class="text-xl font-semibold text-[var(--text-main)]">{copy.about.buildingTitle}</h2>
          <p class="mt-3 text-[var(--text-muted)]">{copy.about.buildingBody}</p>
        </section>
      </div>

      <aside class="space-y-6">
        <section class="rounded-[0.75rem] border border-[var(--border)] bg-[var(--surface)] p-6">
          <p class="eyebrow">Keywords</p>
          <p class="flat-item-tags mt-4">{ui[lang].currentFocus.join(" · ")}</p>
        </section>

        <section class="rounded-[0.75rem] border border-[var(--border)] bg-[var(--surface)] p-6">
          <h2 class="text-xl font-semibold text-[var(--text-main)]">{copy.about.contactTitle}</h2>
          <p class="mt-3 text-[var(--text-muted)]">{copy.about.contactBody}</p>
          <div class="mt-5 border-t border-[var(--border-paper)] pt-4">
            <p class="text-[0.72rem] font-medium uppercase tracking-[0.08em] text-[var(--text-subtle)]">
              Links
            </p>
            <div class="mt-2.5 flex flex-wrap gap-2">
              <SocialLink platform="github" href={GITHUB_URL} label={copy.labels.github} handle={GITHUB_HANDLE} iconOnly />
              <SocialLink platform="bilibili" href={BILIBILI_URL} label={copy.labels.bilibili} handle={BILIBILI_HANDLE} iconOnly />
              <SocialLink platform="x" href={X_URL} label={copy.labels.x} handle={X_HANDLE} iconOnly />
              <SocialLink platform="xiaohongshu" href={XIAOHONGSHU_URL} label={copy.labels.xiaohongshu} handle={XIAOHONGSHU_HANDLE} iconOnly />
              <SocialLink platform="wechat" href={WECHAT_URL} label={copy.labels.wechat} handle={WECHAT_HANDLE} iconOnly />
            </div>
          </div>
        </section>
      </aside>
    </div>
  </Container>
</section>

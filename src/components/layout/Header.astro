---
import Container from "./Container.astro";
import LanguageSwitch from "../ui/LanguageSwitch.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import { ui } from "../../i18n/ui";
import {
  GITHUB_HANDLE,
  GITHUB_URL,
  getAboutPath,
  getCollectionPath,
  getFriendsPath,
  getGuestbookPath,
  getHomePath,
  type SiteLang,
} from "../../i18n/utils";

interface Props {
  lang: SiteLang;
  currentPath: string;
  translationHref?: string;
}

const { lang, currentPath, translationHref } = Astro.props;
const copy = ui[lang];

const navItems = [
  { href: getHomePath(lang), label: copy.nav.home, key: "home" },
  { href: getCollectionPath("writing", lang), label: copy.nav.writing, key: "writing" },
  { href: getCollectionPath("projects", lang), label: copy.nav.projects, key: "projects" },
  { href: getCollectionPath("life", lang), label: copy.nav.life, key: "life" },
  { href: getGuestbookPath(lang), label: copy.nav.guestbook, key: "guestbook" },
  { href: getFriendsPath(lang), label: copy.nav.friends, key: "friends" },
  { href: getAboutPath(lang), label: copy.nav.about, key: "about" },
];

const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <Container>
    <div class="site-header-inner">
      <a
        href={getHomePath(lang)}
        class="site-brand"
      >
        sikm
      </a>

      <nav class="site-nav">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "site-nav-link",
              isActive(item.href) && "is-active",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="site-tools">
        <a
          href={GITHUB_URL}
          class="site-github-link"
          target="_blank"
          rel="noreferrer"
          aria-label={`GitHub ${GITHUB_HANDLE}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18a2.65 2.65 0 0 0-1.11-1.46c-.91-.62.07-.61.07-.61a2.1 2.1 0 0 1 1.53 1.03 2.13 2.13 0 0 0 2.91.83 2.13 2.13 0 0 1 .63-1.34c-2.22-.25-4.56-1.11-4.56-4.95a3.87 3.87 0 0 1 1.03-2.69 3.6 3.6 0 0 1 .1-2.65s.84-.27 2.75 1.03A9.47 9.47 0 0 1 12 6.98a9.5 9.5 0 0 1 2.5.34c1.9-1.3 2.74-1.03 2.74-1.03.55 1.38.2 2.4.1 2.65a3.86 3.86 0 0 1 1.03 2.69c0 3.85-2.34 4.69-4.57 4.94a2.39 2.39 0 0 1 .68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            />
          </svg>
          <span>{`github.com/${GITHUB_HANDLE}`}</span>
        </a>
        <ThemeToggle />
        <LanguageSwitch href={translationHref} label={copy.nav.languageSwitch} />
      </div>
    </div>
  </Container>
</header>

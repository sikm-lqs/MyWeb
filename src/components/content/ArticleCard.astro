---
import { formatDate, type SiteLang } from "../../i18n/utils";

interface Props {
  href: string;
  title: string;
  summary: string;
  publishedAt: string;
  tags?: string[];
  readTime?: string;
  lang: SiteLang;
  featured?: boolean;
}

const {
  href,
  title,
  summary,
  publishedAt,
  tags = [],
  readTime,
  lang,
  featured = false,
} = Astro.props;

const visibleTags = tags.slice(0, 3);
---

<article class:list={["flat-item", featured && "flat-item-featured"]}>
  <div class="flat-item-meta">
    <span>{formatDate(publishedAt, lang)}</span>
    {readTime && (
      <>
        <span aria-hidden="true">·</span>
        <span>{readTime}</span>
      </>
    )}
  </div>

  <h3 class="flat-item-title">
    <a href={href} class="content-card-title-link">
      {title}
    </a>
  </h3>

  <p class="flat-item-summary">{summary}</p>

  {visibleTags.length > 0 && (
    <p class="flat-item-tags">{visibleTags.join(" · ")}</p>
  )}
</article>

---
import { formatDate, type SiteLang } from "../../i18n/utils";

interface Props {
  href: string;
  title: string;
  summary: string;
  status?: string;
  stack: string[];
  publishedAt?: string;
  lang?: SiteLang;
  repoUrl?: string;
  demoUrl?: string;
}

const {
  href,
  title,
  summary,
  status,
  stack,
  publishedAt,
  lang = "zh-CN",
  repoUrl,
  demoUrl,
} = Astro.props;
---

<article class="flat-item">
  <div class="flat-item-meta">
    {status && <span>{status}</span>}
    {status && publishedAt && <span aria-hidden="true">·</span>}
    {publishedAt && <span>{formatDate(publishedAt, lang)}</span>}
  </div>

  <h3 class="flat-item-title">
    <a href={href} class="content-card-title-link">
      {title}
    </a>
  </h3>

  <p class="flat-item-summary flat-item-summary-single">{summary}</p>

  {stack.length > 0 && (
    <p class="flat-item-tags">{stack.join(" · ")}</p>
  )}

  {(repoUrl || demoUrl) && (
    <div class="flat-item-links">
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noreferrer">
          GitHub
        </a>
      )}
      {demoUrl && (
        <a href={demoUrl} target="_blank" rel="noreferrer">
          Demo
        </a>
      )}
    </div>
  )}
</article>

---
import ArticleCard from "./ArticleCard.astro";
import ProjectCard from "./ProjectCard.astro";
import Container from "../layout/Container.astro";
import { ui } from "../../i18n/ui";
import {
  getEntryPath,
  getPublishedEntries,
} from "../../lib/content/translations";
import { type SiteCollection, type SiteLang } from "../../i18n/utils";

interface Props {
  collection: SiteCollection;
  lang: SiteLang;
}

const { collection, lang } = Astro.props;
const copy = ui[lang];
const entries = await getPublishedEntries(collection, lang);

const collectionEyebrow: Record<SiteCollection, string> = {
  writing: "Blog",
  projects: "Projects",
  life: "Life",
};
---

<section class="pb-20 pt-14">
  <Container>
    <div class="page-head">
      <p class="section-eyebrow">{collectionEyebrow[collection]}</p>
      <h1>{copy.collections[collection].title}</h1>
      <p>{copy.collections[collection].description}</p>
    </div>

    {
      entries.length === 0 ? (
        <div class="mt-8 rounded-[0.75rem] border border-[var(--border)] bg-[var(--surface)] p-8 text-[var(--text-muted)]">
          {copy.collections[collection].empty}
        </div>
      ) : collection === "projects" ? (
        <div class="flat-list mt-10">
          {entries.map((entry) => (
            <ProjectCard
              href={getEntryPath("projects", lang, entry)}
              title={entry.data.title}
              summary={entry.data.summary}
              status={entry.data.status}
              stack={entry.data.stack}
              repoUrl={entry.data.repoUrl}
              demoUrl={entry.data.demoUrl}
              publishedAt={entry.data.publishedAt}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="flat-list mt-8">
          {entries.map((entry, index) => (
            <ArticleCard
              href={getEntryPath(collection, lang, entry)}
              title={entry.data.title}
              summary={entry.data.summary}
              publishedAt={entry.data.publishedAt}
              tags={entry.data.tags}
              readTime={entry.data.readTime}
              lang={lang}
              featured={index === 0}
            />
          ))}
        </div>
      )
    }
  </Container>
</section>
